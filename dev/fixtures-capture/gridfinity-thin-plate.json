{
  "schemaVersion": 1,
  "name": "gridfinity-thin-plate",
  "description": "Build the Gridfinity 2x2 baseplate as a feature tree of THIN custom features that mirror the native modelling steps (sketch, then extrude): one rounded 84x84 body, the 45 deg socket profile as four stacked subtraction layers (clearance, ramp, lock face, flare), and the magnet pockets as a shaft plus a 45 deg mouth chamfer. Every row carries its numbers in the ONE transaction that creates it, so no row is ever added with defaults and edited afterwards. After the run, success is verified outside the runner with browser_get_partstudio_features, a STEP export and the geometry package. This project deliberately contains NO source-refresh step. Committing dev/fixtures-capture/thin-native-features.fs is a separate action, because browser_deploy_and_apply_featurescript reports success only as built=true, which requires the apply to leave at least one COMPUTED PART: its outcome key counts parts, and a sketch-only row creates a sketch with no part, so an in-project refresh is rejected as 'the Part Studio reports no computed parts' even though the commit itself was accepted and the source compiled (measured 2026-09-20). The refresh that preceded this build was proven by content, not by that flag: the compiled source's sha256 was dcd1971d1a3c365a27f895b8d5ae40b73f2617f02d0738a7d08585e261aaa3ac with 0 diagnostics, byte-identical to dev/fixtures-capture/thin-native-features.fs on this disk. Every step below therefore only inserts rows.",
  "steps": [
    {
      "id": "01-plate-sketch",
      "tool": "browser_insert_custom_feature",
      "args": {
        "feature_name": "Thin Sketch Rectangle",
        "part_studio_tab": "GF Thin Plate",
        "parameters": {
          "origin_x": "0 mm",
          "origin_y": "0 mm",
          "origin_z": "0 mm",
          "grid_x": 1,
          "grid_y": 1,
          "cell_pitch": "42 mm",
          "width": "84 mm",
          "height": "84 mm",
          "corner_radius": "4 mm"
        },
        "confirm_mutation": true
      }
    },
    {
      "id": "02-plate-extrude",
      "tool": "browser_insert_custom_feature",
      "args": {
        "feature_name": "Thin Extrude",
        "part_studio_tab": "GF Thin Plate",
        "parameters": {
          "depth": "10 mm"
        },
        "confirm_mutation": true
      }
    },
    {
      "id": "03-socket-clearance-sketch",
      "tool": "browser_insert_custom_feature",
      "args": {
        "feature_name": "Thin Sketch Rectangle",
        "part_studio_tab": "GF Thin Plate",
        "parameters": {
          "origin_z": "5 mm",
          "grid_x": 2,
          "grid_y": 2,
          "cell_pitch": "42 mm",
          "width": "36.3 mm",
          "height": "36.3 mm",
          "corner_radius": "1.15 mm"
        },
        "confirm_mutation": true
      }
    },
    {
      "id": "04-socket-clearance-cut",
      "tool": "browser_insert_custom_feature",
      "args": {
        "feature_name": "Thin Extrude",
        "part_studio_tab": "GF Thin Plate",
        "parameters": {
          "depth": "0.35 mm",
          "subtract": true
        },
        "confirm_mutation": true
      }
    },
    {
      "id": "05-socket-ramp-sketch",
      "tool": "browser_insert_custom_feature",
      "args": {
        "feature_name": "Thin Sketch Rectangle",
