# Merge these entries into the target DSH profile's cordis.patch.yml.
# Replace <repo> with the absolute WSL checkout path and install
# @deepseek-ai/dsh-mcp-client in that profile first.
#
# The MCP client spawns mcp_bridge_entry.sh (the DSH-plugin orchestration
# entry): it first checks whether the Windows bridge is reachable, starts it
# via wsl_bridge_ctl.sh when it is not, then execs the stdio<->TCP relay. This
# removes the "relay exits because the Windows bridge was never started"
# failure mode; the relay/body never run in WSL.
- insert:
    - id: mcp-onshape-featurescript
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: onshape
        transport: stdio
        command: bash
        args:
          - <repo>/mcp_main/wsl/mcp_bridge_entry.sh
          - '8766'
        cwd: <repo>
        toolCallTimeoutMs: 300000
        failOnStartupError: false
        reconnect:
          enabled: true
          initialDelayMs: 500
          maxDelayMs: 30000
          maxAttempts: 10
    - id: mcp-onshape-runtime-policy
      name: <repo>/mcp_main/wsl/dsh/runtime-prompt-companion.js
      config: {}
